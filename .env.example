NEXT_PUBLIC_SUPABASE_URL=https://shxpqufymaxwvwamlmmz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional overrides for the original gallery project (public values are bundled).
# These map to the original site's VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
NEXT_PUBLIC_GALLERY_SUPABASE_URL=
NEXT_PUBLIC_GALLERY_SUPABASE_ANON_KEY=
# Optional override for the existing contact delivery workflow.
LDMB_CONTACT_WEBHOOK_URL=

# Server-only. Required by first-party heatmap ingestion/admin APIs. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Stable labels for separating materially different layouts/deployments.
NEXT_PUBLIC_SITE_VERSION=
NEXT_PUBLIC_LAYOUT_VERSION=
ANALYTICS_SITE_VERSION=
ANALYTICS_LAYOUT_VERSION=
# Canonical production origin used to reject cross-site ingestion.
ANALYTICS_ALLOWED_ORIGIN=https://littledoomudbog.com
# Optional immutable preview URL for the current deployment.
ANALYTICS_PREVIEW_URL=
# Keep false/blank in normal local development to avoid test traffic.
NEXT_PUBLIC_ANALYTICS_IN_DEVELOPMENT=false
